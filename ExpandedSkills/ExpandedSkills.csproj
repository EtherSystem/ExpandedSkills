<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>ExpandedSkills</RootNamespace>
		<AssemblyName>ExpandedSkills</AssemblyName>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<Version>1.1.1</Version>
		<AssemblyVersion>1.1.1.0</AssemblyVersion>
		<FileVersion>1.1.1.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Platforms>AnyCPU;x64</Platforms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<TheLongDarkPath>D:\SteamLibrary\steamapps\common\TheLongDark</TheLongDarkPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="ModData">
			<HintPath>$(TheLongDarkPath)\Mods\ModData.dll</HintPath>
		</Reference>
		<Reference Include="ModSettings">
			<HintPath>$(TheLongDarkPath)\Mods\ModSettings.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="Exists('$(TheLongDarkPath)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll')">
		<Reference Include="$(TheLongDarkPath)\MelonLoader\Il2CppAssemblies\*.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(TheLongDarkPath)\MelonLoader\net6\MelonLoader.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(TheLongDarkPath)\MelonLoader\net6\0Harmony.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(TheLongDarkPath)\MelonLoader\net6\Il2CppInterop.Runtime.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(TheLongDarkPath)\MelonLoader\net6\Il2CppInterop.Common.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="!Exists('$(TheLongDarkPath)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll')">
		<PackageReference Include="Waltz.Modding.TLD.Il2CppAssemblies.Windows" Version="2.52.0" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Il2Cpp" />
		<Using Include="HarmonyLib" />
		<Using Include="MelonLoader" />
		<Using Include="UnityEngine" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="Build" Condition="Exists('$(TheLongDarkPath)\Mods')">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TheLongDarkPath)\Mods" SkipUnchangedFiles="true" />
	</Target>
</Project>